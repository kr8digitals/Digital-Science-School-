# Hosting target: generic (local), hostinger-managed, or hostinger-vps.
HOSTING_TARGET=generic
# Set only after verifying that DATA_DIR is private and survives redeploys.
PERSISTENT_STORAGE_CONFIRMED=false
# Node process and the number of trusted reverse-proxy hops (0 for direct access).
PORT=3000
TRUST_PROXY_HOPS=1
LAUNCH_MODE=preview
PUBLIC_URL=
# First startup only. Existing accounts are NEVER reset from these values on restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Private, persistent storage; default ./data. Do not commit this directory.
# DATA_DIR=/absolute/path/to/private-storage
# BACKUP_DIR=/absolute/path/to/private-backups

# Payment activation is explicit. Use a TEST key in preview and test the merchant integration.
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=

# Transactional SMTP. Leave off until configured. Credentials stay server-side.
MAIL_DELIVERY=off
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Plain sender email, not a display-name string. Verify with your provider.
MAIL_FROM=
# REQUIRED for preview SMTP: all test messages go here, never to applicants.
MAIL_TEST_RECIPIENT=

# Owner attestations, not automatic certifications. Set true only after real review.
POLICIES_APPROVED=false
UPLOAD_SCANNING_REVIEWED=false

# Docker Compose / Caddy only. No https:// prefix. Point DNS to your host first.
SCHOOL_DOMAIN=
